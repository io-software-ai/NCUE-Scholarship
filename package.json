{
  "name": "ncue-scholarship-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w @ncue/web",
    "web:build": "npm run build -w @ncue/web",
    "mobile:dev": "npm run dev -w @ncue/mobile",
    "core:build": "npm run build -w @ncue/core",
    "prepare": "npm run core:build"
  },
  "devDependencies": {
    "nativewind": "^4.2.6",
    "tailwindcss": "^3.4.19"
  }
}
