# =============================================================
# NCUE Scholarship Platform — 環境變數
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- 網址 ---
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- 寄信 SMTP ---
SENDER_EMAIL=YOUR_SENDER_EMAIL
# 問題回報收件信箱（未設定時使用 SENDER_EMAIL）
FEEDBACK_EMAIL=
SENDER_NAME="Your Scholarship Information Platform"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_SMTP_USERNAME
SMTP_PASSWORD=YOUR_GMAIL_SMTP_PASSWORD

# --- Google 登入 ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- 排程密鑰 ---
CRON_SECRET=change-me-to-a-long-random-string

# --- 校外使用者自備 AI 金鑰的加密密鑰 ---
# 校外使用者選擇「將 Gemini 金鑰存於雲端」時，平台以此密鑰派生 AES-256-GCM 加密後存入 user_ai_keys。
# 未設定時會退而使用 SUPABASE_SERVICE_ROLE_KEY 派生（一旦輪替該 key，既有密文將無法解密）。
API_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string